# Скопируйте этот файл в .env и заполните значения. .env никогда не коммитится.

# Приложение
APP_ENV=dev
APP_PORT=8000

# База данных (заглушка для будущей разноски чеков/выписок)
DB_PORT=5432
DATABASE_URL=postgresql://rddh:rddh@db:5432/rddh

# LLM-провайдер для категоризации операций (заполняется на лабе 2+)
LLM_API_KEY=stub
