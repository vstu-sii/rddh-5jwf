# Скопируйте этот файл в .env и заполните значения. .env никогда не коммитится.

# Порты на хосте
APP_PORT=8000
EMPLOYEE_APP_PORT=3000
BACKOFFICE_PORT=3001

# БД расходов (expense_db). Схема применяется из database/schema.sql при первом старте.
POSTGRES_USER=rddh
POSTGRES_PASSWORD=rddh
POSTGRES_DB=rddh

# Файлы чеков (receipt_files, S3 API)
S3_BUCKET=receipts

# LLM-адаптер: local — Ollama (docker compose --profile local-llm up), cloud — внешний провайдер
LLM_PROVIDER=local
LLM_BASE_URL=http://llm_runtime:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_MAX_INPUT_TOKENS=1000
LLM_MAX_OUTPUT_TOKENS=150

# ФНС «Проверка чека» — токен выдаётся по заявлению, до этого адаптер работает как заглушка
FNS_API_TOKEN=
