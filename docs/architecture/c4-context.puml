@startuml c4-context
!include <C4/C4_Context>

title RDDH — компенсация расходов сотрудников: C4 Level 1 (System Context)

Person(employee, "Сотрудник", "Тратит на английский язык и спорт, ждёт компенсацию от компании. Подаёт чек фото или PDF из мобильного приложения под своей учётной записью")
Person(accountant, "Бухгалтер", "Проверяет, подходит ли категория расхода под политику компенсации, формирует реестр на выплату")

System(rddh, "RDDH", "Распознаёт чеки, структурирует расходы по категориям политики, помечает спорные и собирает отчёт для бухгалтера")

System_Ext(fns_api, "ФНС «Проверка чека»", "Фискальные реквизиты чека по QR-коду")
System_Ext(cloud_llm, "Облачный LLM-провайдер", "GPT-5 mini / GigaChat 2 Lite — резерв, если локальная модель недоступна")

Rel(employee, rddh, "Загружает чек, подтверждает поля, видит статус и причину решения", "PWA")
Rel(accountant, rddh, "Разбирает спорные расходы, принимает решение с причиной, формирует реестр", "Web")
Rel(rddh, fns_api, "Запрашивает реквизиты по QR", "HTTPS")
Rel(rddh, cloud_llm, "Категоризация при деградации локальной модели", "HTTPS")

SHOW_LEGEND()
@enduml
